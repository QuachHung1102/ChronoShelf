{
  "name": "chronoshelf",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --cache --cache-location node_modules/.cache/eslint",
    "prepare": "git config core.hooksPath .githooks || exit 0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --test \"lib/**/*.test.ts\"",
    "check": "npm run design:lint && npm run design:verify && npm run design:dead-class && npm test && npm run lint && npm run build",
    "db:check": "node --env-file-if-exists=.env.local scripts/db-check.mjs",
    "seed:content": "node scripts/seed-content.mjs",
    "design:lint": "designmd lint DESIGN.md | node scripts/design-lint-gate.mjs",
    "design:build": "designmd export --format json-tailwind DESIGN.md > tailwind.theme.json && node scripts/design-line-height.mjs",
    "design:verify": "designmd export --format json-tailwind DESIGN.md > node_modules/.tailwind.theme.gen.json && node scripts/design-line-height.mjs node_modules/.tailwind.theme.gen.json && git diff --no-index --quiet tailwind.theme.json node_modules/.tailwind.theme.gen.json",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/db-migrate.mjs",
    "db:mutation": "node --env-file-if-exists=.env.local scripts/db-mutation-check.mjs",
    "design:dead-class": "node scripts/design-dead-class.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.31.0",
    "next": "16.3.0",
    "pg": "^8.23.0",
    "pg-hstore": "^2.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sequelize": "^6.37.8"
  },
  "devDependencies": {
    "@google/design.md": "^0.4.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.20",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "postcss": "^8.4.49",
    "sass": "^1.102.0",
    "tailwindcss": "3.4.17",
    "typescript": "^5"
  }
}
