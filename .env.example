# Sao chép file này thành .env.local rồi điền giá trị THẬT. .env.local đã bị .gitignore;
# file .env.example này thì được commit — vì vậy KHÔNG được điền giá trị thật vào đây.

# Bắt buộc. Chuỗi kết nối PostgreSQL cho ỨNG DỤNG.
#
# Phải là role `chronoshelf_app`, KHÔNG PHẢI `postgres`. Superuser bỏ qua toàn bộ RLS,
# nên nối bằng nó sẽ làm mọi policy trong db/schema/05-content-rls.sql ngừng tác dụng
# trong im lặng — ứng dụng vẫn chạy y như thường và không có gì báo cho ai biết.
#
# Thiếu biến này thì lib/db/sequelize.ts throw ngay lúc nạp module, nên cả
# `npm run dev` lẫn `npm run build` (và do đó `npm run check`) đều dừng lại.
DATABASE_URL=postgres://chronoshelf_app:MAT_KHAU@127.0.0.1:5432/chronoshelf

# Bắt buộc. Khóa ký cookie phiên đăng nhập, tối thiểu 32 ký tự.
# Sinh một cái:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#
# Đổi khóa này = đăng xuất toàn bộ người dùng. Ở bản chạy thật, mọi tiến trình phải
# dùng CHUNG một khóa, nếu không người dùng bị đăng xuất ngẫu nhiên khi request rơi
# vào tiến trình khác.
SESSION_SECRET=

# Chỉ dùng cho `npm run db:migrate` và `npm run db:mutation` — hai lệnh này tạo role,
# đổi schema và sửa policy nên cần quyền superuser. Ứng dụng KHÔNG BAO GIỜ dùng nó.
# Cố ý để trống ở đây và truyền theo từng lệnh, thay vì cất trong .env.local:
#   PGADMIN_URL=postgres://postgres:...@127.0.0.1:5432/chronoshelf npm run db:migrate
PGADMIN_URL=
