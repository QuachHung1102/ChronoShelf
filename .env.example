# Sao chép file này thành .env.local rồi điền giá trị THẬT. .env.local đã bị .gitignore;
# file .env.example này thì được commit — vì vậy KHÔNG được điền giá trị thật vào đây.

# Bắt buộc. Thiếu một trong hai biến này thì lib/insforge/client.ts throw ngay lúc nạp
# module — cả `npm run dev` lẫn `npm run build` (nên cả `npm run check`) đều dừng lại, kể cả
# khi không route nào thật sự cần gọi mạng lúc build (xem CLAUDE.md mục "Lệnh"). Lấy giá trị
# qua MCP `get-backend-metadata` / `get-anon-key`, hoặc từ InsForge dashboard.
NEXT_PUBLIC_INSFORGE_BASE_URL=
NEXT_PUBLIC_INSFORGE_ANON_KEY=

# Tùy chọn. Chỉ cần cho `npm run db:check` — 6 trong 15 phép của nó kiểm "người đã đăng nhập
# nhưng không phải admin", nên cần một tài khoản test thật. Thiếu hai biến này thì db:check
# vẫn chạy 9 phép còn lại (chạy được khi chưa đăng nhập) và báo BỎ QUA 6 phép kèm cảnh báo to —
# đó là bỏ qua, không phải lỗi, nhưng cũng không phải "đạt". Tạo tài khoản test bằng
# `auth.signUp` (SDK) rồi `UPDATE auth.users SET email_verified = true` một lần qua MCP
# `run-raw-sql` — backend đang bật xác minh email nên thiếu bước đó sẽ không đăng nhập được.
DB_CHECK_USER_EMAIL=
DB_CHECK_USER_PASSWORD=
