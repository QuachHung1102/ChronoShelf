# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# MCP config cuc bo (co the chua khoa API)
.mcp.json

# absolute symlinks into .agents/skills, regenerated by the skill installer.
# the skills themselves are tracked in .agents/ + skills-lock.json
.claude/skills/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude local settings (co the chua khoa API)
.claude/settings.local.json

# ảnh chụp màn hình khi kiểm tra UI + output của Playwright MCP
/*.png
.playwright-mcp/

# cau hinh Codex cuc bo — config.toml chua Bearer token cua MCP server
.codex/config.toml
