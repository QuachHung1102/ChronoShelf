{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(npm run build)",
      "Bash(npm run lint)",
      "Bash(npm run design:lint)",
      "Bash(npm run typecheck)",
      "Bash(npm run check)",
      "Bash(npm test)",
      "Bash(npm ls:*)",
      "mcp__pencil__get_app_state",
      "mcp__pencil__get_guidelines",
      "mcp__pencil__get_screenshot",
      "mcp__plugin_context7_context7__resolve-library-id",
      "mcp__plugin_context7_context7__query-docs"
    ],
    "deny": [
      "Read(pen.dev/**)",
      "Edit(pen.dev/**)",
      "Write(pen.dev/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/guard-pen-dev.mjs"
          }
        ]
      }
    ]
  }
}
